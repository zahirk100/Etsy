# Copy to .env and fill in once you have real accounts.
#
# DROPSHIP_TEST_MODE is an explicit override, not a default you need to set:
# - left unset (default): each integration below goes live independently as
#   soon as ITS OWN credentials are filled in — e.g. Shopify can run for
#   real while Facebook is still empty/mocked.
# - DROPSHIP_TEST_MODE=true: force everything mocked regardless of what's filled in.
# - DROPSHIP_TEST_MODE=false: require every credential below to be present,
#   and go fully live everywhere (fails loudly if anything is missing).
# DROPSHIP_TEST_MODE=

# --- Shopify (Admin API custom app token) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=

# --- Facebook / Meta Marketing API ---
FACEBOOK_AD_ACCOUNT_ID=act_1234567890
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# The Pixel connected via Shopify's Facebook & Instagram sales channel --
# find it in Events Manager (business.facebook.com/events_manager).
FACEBOOK_PIXEL_ID=

# --- Optional: AI-generated ad copy (console.anthropic.com) ---
# When set, Claude writes catchy per-product ad copy instead of static
# templates. Falls back to templates automatically if unset or a call fails.
ANTHROPIC_API_KEY=

# --- AliExpress (free Affiliate API, portals.aliexpress.com) ---
# Leave blank to use ALIEXPRESS_CSV_PATH instead (manually curated picks,
# no approval wait). Order fulfillment is handled separately by the free
# DSers Shopify app, not by this codebase.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_CSV_PATH=
# Optional: narrows the Affiliate API's "hot products" query to a niche
# instead of whatever's broadly trending, e.g. "fashion accessories jewelry
# sunglasses handbags". Ignored by the CSV path.
ALIEXPRESS_SEARCH_KEYWORDS=

# --- Market ---
DROPSHIP_TARGET_COUNTRY=GB

# Narrow the initial audience with category interests (looked up live via
# Meta's Ads Targeting Search) instead of pure broad geo+age targeting.
# Set to false to go back to fully broad -- Meta's own algorithm sometimes
# finds buyers just as well or better, especially at small daily budgets.
DROPSHIP_INTEREST_TARGETING_ENABLED=true

# How many campaigns should be actively testing at once. `monitor` launches
# new untested products to fill any slot that opens up after a pause.
DROPSHIP_TARGET_ACTIVE_CAMPAIGNS=3

# --- Guardrails ---
DROPSHIP_DAILY_BUDGET_CAP_USD=20
DROPSHIP_STARTING_DAILY_BUDGET_USD=5
DROPSHIP_MAX_DAILY_INCREASE_PCT=20
DROPSHIP_COOLDOWN_HOURS=24
DROPSHIP_PAUSE_CPA_USD=25
# Kill a campaign once it has spent this % of ITS OWN daily budget with 0 sales.
DROPSHIP_PAUSE_SPEND_PCT_NO_SALE=50
# But not before this many link-clicks -- at small budgets, hitting the %
# above can mean just 1-3 clicks, too small a sample to judge a product on.
DROPSHIP_MIN_LINK_CLICKS_BEFORE_KILL=10
# Hard safety net: pause regardless of click count once spend hits this %
# (catches a broken/very-low-CTR ad that would otherwise never rack up
# enough clicks to be judged by the rule above).
DROPSHIP_HARD_STOP_SPEND_PCT_NO_SALE=100
# Scale up as soon as a campaign has at least this many purchases (still
# capped, cooldown-limited, and blocked if CPA is above DROPSHIP_PAUSE_CPA_USD).
DROPSHIP_SCALE_MIN_PURCHASES=1
