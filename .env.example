# Copy to .env and fill in once you have real accounts. Leave DROPSHIP_TEST_MODE=true
# (or this whole file absent) to run the full pipeline against mock data with
# zero real API calls and zero ad spend.

DROPSHIP_TEST_MODE=true

# --- Shopify (Admin API custom app token) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=

# --- Facebook / Meta Marketing API ---
FACEBOOK_AD_ACCOUNT_ID=act_1234567890
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- Supplier (e.g. CJdropshipping) ---
SUPPLIER_API_KEY=

# --- Market ---
DROPSHIP_TARGET_COUNTRY=GB

# --- Guardrails ---
DROPSHIP_DAILY_BUDGET_CAP_USD=20
DROPSHIP_STARTING_DAILY_BUDGET_USD=5
DROPSHIP_MAX_DAILY_INCREASE_PCT=20
DROPSHIP_COOLDOWN_HOURS=24
DROPSHIP_PAUSE_CPA_USD=25
DROPSHIP_SCALE_ROAS=2.0
DROPSHIP_MIN_SPEND_JUDGE_USD=15
